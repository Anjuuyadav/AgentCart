PORT=4000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_NAME=agentcart
DB_USER=postgres
DB_PASSWORD=postgres

CORS_ORIGIN=http://localhost:5173

# Optional n8n automation
N8N_WEBHOOK_URL=http://localhost:5678/webhook/agentcart/events
# Optional shared secret sent as x-agentcart-webhook-secret
N8N_WEBHOOK_SECRET=
# Public backend URL included in events sent to n8n Cloud
AGENTCART_BACKEND_URL=

# Razorpay Test Mode credentials (backend only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
